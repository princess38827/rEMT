<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, viewport-fit=cover">
<title>Field Guide 24910 — Emergency Response</title>
<meta name="description" content="Offline-capable emergency response field guide for Alderson & the Greenbrier Valley, WV. CPR, bleeding control, choking, mass-casualty triage, hospitals, weather hazards and local contacts.">
<meta name="theme-color" content="#14181A">
<link rel="manifest" href="manifest.json">
<link rel="icon" href="icon.svg" type="image/svg+xml">
<link rel="apple-touch-icon" href="icon.svg">
<style>
  :root{
    --bg:#14181A;
    --surface:#1E2427;
    --surface-raised:#262D31;
    --line:#333B3F;
    --text:#F2EFE9;
    --text-dim:#9BA3A6;
    --accent:#F0A93C;
    --accent-dim:#B87F26;
    --on-accent:#1A1305;
    --danger:#E4483B;
    --on-danger:#150403;
    --go:#4C9A6A;
    --hold:#7C8794;
    --radius:14px;
    --safe-t:env(safe-area-inset-top,0px);
    --safe-b:env(safe-area-inset-bottom,0px);
    --safe-l:env(safe-area-inset-left,0px);
    --safe-r:env(safe-area-inset-right,0px);
    --mono: ui-monospace, "SF Mono", "Cascadia Mono", "Roboto Mono", Consolas, Menlo, monospace;
    --sans: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  }
  *{box-sizing:border-box;}
  html,body{margin:0;padding:0;background:var(--bg);color:var(--text);font-family:var(--sans);-webkit-tap-highlight-color:transparent;}
  body{padding-bottom:calc(24px + var(--safe-b));min-height:100vh;}
  h1,h2,h3{margin:0;font-family:var(--sans);letter-spacing:-0.01em;}
  p{margin:0 0 10px;line-height:1.5;color:var(--text);}
  a{color:var(--accent);}
  button{font-family:inherit;}
  ::selection{background:var(--accent);color:var(--on-accent);}
  :focus-visible{outline:3px solid var(--accent);outline-offset:2px;}

  .eyebrow{font-size:11px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:var(--text-dim);}

  /* ---------- Top chrome ---------- */
  .call-bar{
    position:sticky;top:0;z-index:40;
    padding:calc(10px + var(--safe-t)) calc(14px + var(--safe-r)) 10px calc(14px + var(--safe-l));
    background:var(--bg);border-bottom:1px solid var(--line);
  }
  .call-btn{
    width:100%;display:flex;align-items:center;justify-content:center;gap:10px;
    background:var(--danger);color:var(--on-danger);border:none;border-radius:12px;
    padding:14px 16px;font-size:19px;font-weight:800;letter-spacing:.02em;text-decoration:none;
  }
  .call-btn svg{width:22px;height:22px;flex:none;}
  .call-btn:active{transform:scale(.98);}

  .topbar{
    position:sticky;top:calc(58px + var(--safe-t));z-index:39;
    display:flex;align-items:center;gap:10px;
    padding:10px calc(14px + var(--safe-r)) 10px calc(14px + var(--safe-l));
    background:var(--bg);border-bottom:1px solid var(--line);
  }
  .back-btn{
    background:none;border:1px solid var(--line);color:var(--text);border-radius:10px;
    width:38px;height:38px;flex:none;display:flex;align-items:center;justify-content:center;visibility:hidden;
  }
  .back-btn svg{width:18px;height:18px;}
  .top-title{font-size:15px;font-weight:800;text-transform:uppercase;letter-spacing:.06em;flex:1;}
  .clock{font-family:var(--mono);font-size:13px;color:var(--text-dim);font-variant-numeric:tabular-nums;}

  main{max-width:640px;margin:0 auto;padding:16px calc(14px + var(--safe-r)) 40px calc(14px + var(--safe-l));}
  .screen{display:none;}
  .screen.active{display:block;animation:fade .18s ease-out;}
  @keyframes fade{from{opacity:0}to{opacity:1}}
  @media (prefers-reduced-motion:reduce){.screen.active{animation:none;}}

  /* ---------- Home ---------- */
  .home-head{margin:6px 2px 18px;}
  .home-head h1{font-size:26px;font-weight:800;}
  .home-head .loc{color:var(--accent);font-family:var(--mono);font-size:13px;margin-top:6px;}
  .section-label{font-size:11px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:var(--text-dim);margin:22px 2px 8px;}
  .section-label:first-of-type{margin-top:0;}

  .card{
    position:relative;display:flex;align-items:center;gap:14px;width:100%;text-align:left;
    background:var(--surface);border:1px solid var(--line);border-radius:var(--radius);
    padding:14px 16px 14px 18px;margin-bottom:10px;color:var(--text);
    text-decoration:none;
  }
  .card::before{
    content:"";position:absolute;left:0;top:10px;bottom:10px;width:4px;border-radius:3px;
    background:var(--tab,var(--accent));
  }
  .card:active{background:var(--surface-raised);}
  .card .icon{flex:none;width:38px;height:38px;border-radius:10px;background:var(--surface-raised);
    display:flex;align-items:center;justify-content:center;color:var(--tab,var(--accent));}
  .card .icon svg{width:20px;height:20px;}
  .card .body{flex:1;min-width:0;}
  .card .title{font-weight:700;font-size:16px;}
  .card .sub{color:var(--text-dim);font-size:13px;margin-top:2px;}
  .card .chev{flex:none;color:var(--text-dim);}
  .card .chev svg{width:16px;height:16px;}

  .card--red{--tab:var(--danger);}
  .card--amber{--tab:var(--accent);}
  .card--green{--tab:var(--go);}
  .card--blue{--tab:#5B8DBE;}
  .card--gray{--tab:var(--hold);}

  /* ---------- Generic screen content ---------- */
  .lead{color:var(--text-dim);font-size:14px;margin-bottom:16px;}
  .block{background:var(--surface);border:1px solid var(--line);border-radius:var(--radius);padding:16px;margin-bottom:14px;}
  .block h3{font-size:13px;text-transform:uppercase;letter-spacing:.08em;color:var(--accent);margin-bottom:10px;}

  .steps{list-style:none;margin:0;padding:0;counter-reset:step;}
  .steps li{counter-increment:step;position:relative;padding:2px 0 14px 34px;font-size:15px;line-height:1.5;}
  .steps li::before{
    content:counter(step);position:absolute;left:0;top:0;width:24px;height:24px;border-radius:50%;
    background:var(--accent);color:var(--on-accent);font-family:var(--mono);font-weight:800;font-size:12px;
    display:flex;align-items:center;justify-content:center;
  }
  .steps li:last-child{padding-bottom:0;}
  .steps strong{color:var(--accent);}

  .btn{
    display:inline-flex;align-items:center;justify-content:center;gap:8px;width:100%;
    border-radius:12px;padding:14px 16px;font-size:16px;font-weight:700;border:1px solid var(--line);
    background:var(--surface-raised);color:var(--text);text-decoration:none;margin-bottom:10px;
  }
  .btn:active{transform:scale(.98);}
  .btn-accent{background:var(--accent);color:var(--on-accent);border-color:var(--accent);}
  .btn-danger{background:var(--danger);color:var(--on-danger);border-color:var(--danger);}
  .btn-ghost{background:transparent;}
  .btn-row{display:flex;gap:10px;}
  .btn-row .btn{margin-bottom:0;}

  .tag-note{display:flex;gap:8px;align-items:flex-start;background:var(--surface-raised);border-radius:10px;padding:10px 12px;margin:10px 0;font-size:13px;color:var(--text-dim);}

  /* ---------- CPR ---------- */
  .tabs{display:flex;gap:8px;margin-bottom:14px;}
  .tab{flex:1;text-align:center;padding:10px;border-radius:10px;border:1px solid var(--line);background:var(--surface);color:var(--text-dim);font-weight:700;font-size:13px;}
  .tab.active{background:var(--accent);color:var(--on-accent);border-color:var(--accent);}
  .tab-panel{display:none;}
  .tab-panel.active{display:block;}

  .metro{background:var(--surface);border:1px solid var(--line);border-radius:var(--radius);padding:20px;text-align:center;margin-bottom:14px;}
  .metro-dot{width:64px;height:64px;border-radius:50%;background:var(--surface-raised);border:2px solid var(--accent);
    margin:0 auto 14px;display:flex;align-items:center;justify-content:center;transition:transform .06s, background .06s;}
  .metro-dot.beat{background:var(--accent);transform:scale(1.12);}
  @media (prefers-reduced-motion:reduce){.metro-dot{transition:none;}}
  .metro-count{font-family:var(--mono);font-size:44px;font-weight:800;font-variant-numeric:tabular-nums;letter-spacing:-0.02em;}
  .metro-label{color:var(--text-dim);font-size:12px;text-transform:uppercase;letter-spacing:.1em;margin-top:2px;}
  .metro-bpm{font-family:var(--mono);color:var(--accent);font-size:14px;margin-top:10px;}

  /* ---------- Timer readout (tourniquet) ---------- */
  .readout{background:var(--surface-raised);border-radius:10px;padding:14px;text-align:center;margin:12px 0;}
  .readout .val{font-family:var(--mono);font-size:32px;font-weight:800;color:var(--accent);font-variant-numeric:tabular-nums;}
  .readout .cap{font-size:11px;color:var(--text-dim);text-transform:uppercase;letter-spacing:.1em;margin-top:4px;}

  /* ---------- Triage ---------- */
  .tally{display:flex;gap:8px;margin-bottom:16px;}
  .tally div{flex:1;background:var(--surface);border:1px solid var(--line);border-radius:10px;padding:10px 4px;text-align:center;}
  .tally .n{font-family:var(--mono);font-size:22px;font-weight:800;}
  .tally .l{font-size:10px;color:var(--text-dim);text-transform:uppercase;letter-spacing:.08em;margin-top:2px;}
  .tally .red .n{color:var(--danger);} .tally .yellow .n{color:var(--accent);}
  .tally .green .n{color:var(--go);} .tally .black .n{color:var(--hold);}

  .triage-step{display:none;}
  .triage-step.active{display:block;}
  .q{font-size:20px;font-weight:700;margin-bottom:18px;line-height:1.35;}
  .q-help{color:var(--text-dim);font-size:14px;margin:-10px 0 18px;}

  .result-tag{border-radius:16px;padding:28px 20px;text-align:center;margin-bottom:16px;color:#0d0d0d;}
  .result-tag.red{background:var(--danger);color:#fff;}
  .result-tag.yellow{background:var(--accent);}
  .result-tag.green{background:var(--go);color:#fff;}
  .result-tag.black{background:var(--hold);color:#fff;}
  .result-tag .big{font-size:28px;font-weight:900;letter-spacing:.02em;}
  .result-tag .small{font-size:13px;font-weight:700;text-transform:uppercase;letter-spacing:.12em;opacity:.85;margin-top:4px;}
  .result-tag .g{margin-top:14px;font-size:15px;font-weight:600;line-height:1.4;}

  /* ---------- Hospitals ---------- */
  .hcard{background:var(--surface);border:1px solid var(--line);border-radius:var(--radius);padding:16px;margin-bottom:12px;}
  .hcard .htype{display:inline-block;font-size:11px;font-weight:800;letter-spacing:.06em;text-transform:uppercase;
    color:var(--accent);background:rgba(240,169,60,.12);border-radius:6px;padding:3px 8px;margin-bottom:8px;}
  .hcard .hname{font-size:17px;font-weight:800;margin-bottom:4px;}
  .hcard .haddr{color:var(--text-dim);font-size:13px;margin-bottom:8px;}
  .hcard .hdist{font-family:var(--mono);color:var(--accent);font-size:13px;margin-bottom:10px;}
  .hcard .hnote{font-size:13px;color:var(--text-dim);margin-bottom:12px;line-height:1.45;}

  /* ---------- Forms ---------- */
  label{display:block;font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.06em;color:var(--text-dim);margin:14px 0 6px;}
  label:first-child{margin-top:0;}
  input[type=text], input[type=tel], input[type=date], textarea, select{
    width:100%;background:var(--surface-raised);border:1px solid var(--line);border-radius:10px;
    padding:12px 12px;color:var(--text);font-size:15px;font-family:var(--sans);
  }
  textarea{min-height:70px;resize:vertical;}
  .field-pair{display:flex;gap:10px;}
  .field-pair > div{flex:1;}

  .bigcard{background:var(--surface);border:1px solid var(--line);border-radius:var(--radius);padding:22px;}
  .bigcard dt{font-size:11px;color:var(--text-dim);text-transform:uppercase;letter-spacing:.08em;margin-top:16px;}
  .bigcard dt:first-child{margin-top:0;}
  .bigcard dd{margin:4px 0 0;font-size:20px;font-weight:700;}
  .bigcard dd.empty{color:var(--text-dim);font-weight:400;font-size:15px;}

  /* ---------- Weather ---------- */
  .alert-card{border-radius:12px;padding:14px 16px;margin-bottom:10px;border-left:4px solid var(--accent);background:var(--surface);}
  .alert-card.severe{border-left-color:var(--danger);}
  .alert-card .aevent{font-weight:800;font-size:15px;margin-bottom:4px;}
  .alert-card .aarea{color:var(--text-dim);font-size:12px;margin-bottom:6px;}
  .alert-card .adesc{font-size:13px;color:var(--text-dim);line-height:1.5;}

  /* ---------- Reference / checklist ---------- */
  table{width:100%;border-collapse:collapse;font-size:14px;}
  td,th{padding:8px 6px;border-bottom:1px solid var(--line);text-align:left;}
  th{color:var(--text-dim);font-size:11px;text-transform:uppercase;letter-spacing:.06em;}
  td:first-child{font-family:var(--mono);color:var(--accent);font-weight:700;white-space:nowrap;}

  .check{display:flex;align-items:flex-start;gap:12px;padding:12px 0;border-bottom:1px solid var(--line);}
  .check:last-child{border-bottom:none;}
  .check input{width:22px;height:22px;flex:none;accent-color:var(--accent);margin-top:1px;}
  .check label{margin:0;font-size:15px;font-weight:500;text-transform:none;letter-spacing:0;color:var(--text);}
  .check.checked label{color:var(--text-dim);text-decoration:line-through;}

  .badge{display:inline-block;font-size:11px;font-weight:700;padding:2px 8px;border-radius:6px;background:var(--surface-raised);color:var(--text-dim);margin-left:6px;}

  footer.meta{margin-top:30px;padding-top:16px;border-top:1px solid var(--line);color:var(--text-dim);font-size:12px;line-height:1.6;}

  @media print{
    .call-bar,.topbar,.screen:not(#screen-myinfo){display:none !important;}
    #screen-myinfo{display:block !important;}
    body{background:#fff;color:#000;}
    .bigcard{border:2px solid #000;}
  }
</style>
</head>
<body>

<div class="call-bar">
  <a class="call-btn" href="tel:911">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
    CALL 911
  </a>
</div>
<div class="topbar">
  <button class="back-btn" id="backBtn" onclick="goHome()" aria-label="Back">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
  </button>
  <div class="top-title" id="topTitle">Field Guide 24910</div>
  <div class="clock" id="clock">--:--:--</div>
</div>

<main id="app">

  <!-- ===================== HOME ===================== -->
  <section class="screen active" id="screen-home">
    <div class="home-head">
      <h1>Field Guide 24910</h1>
      <div class="loc">ALDERSON · GREENBRIER VALLEY, WV</div>
    </div>

    <div class="section-label">Do this first</div>
    <button class="card card--red" onclick="show('screen-cpr')">
      <span class="icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 12 8 12 10 7 14 17 16 12 21 12"/></svg></span>
      <span class="body"><span class="title">CPR &amp; AED</span><span class="sub">Compression metronome + adult/child/infant steps</span></span>
      <span class="chev"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg></span>
    </button>
    <button class="card card--red" onclick="show('screen-bleed')">
      <span class="icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2s7 7.58 7 12a7 7 0 0 1-14 0c0-4.42 7-12 7-12z"/></svg></span>
      <span class="body"><span class="title">Stop the Bleed</span><span class="sub">Pressure, packing, tourniquet — with a timer</span></span>
      <span class="chev"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg></span>
    </button>
    <button class="card card--amber" onclick="show('screen-choke')">
      <span class="icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="13"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg></span>
      <span class="body"><span class="title">Choking</span><span class="sub">Back blows &amp; abdominal thrusts, adult + infant</span></span>
      <span class="chev"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg></span>
    </button>

    <div class="section-label">Multiple patients</div>
    <button class="card card--amber" onclick="show('screen-triage')">
      <span class="icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.59 13.41L11 3.83V3H4v7l.83.83L14.41 20.6a2 2 0 0 0 2.83 0l3.35-3.35a2 2 0 0 0 0-2.84z"/><circle cx="7.5" cy="7.5" r="1.5"/></svg></span>
      <span class="body"><span class="title">Mass-Casualty Triage</span><span class="sub">START algorithm — tap-through, tags patients</span></span>
      <span class="chev"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg></span>
    </button>

    <div class="section-label">Where to go</div>
    <button class="card card--blue" onclick="show('screen-hospitals')">
      <span class="icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="3" width="16" height="18" rx="1"/><path d="M12 8v6M9 11h6"/></svg></span>
      <span class="body"><span class="title">Hospitals &amp; Directions</span><span class="sub">Nearest ER + regional trauma centers, live distance</span></span>
      <span class="chev"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg></span>
    </button>
    <button class="card card--blue" onclick="show('screen-weather')">
      <span class="icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17.5 19a4.5 4.5 0 0 0 0-9h-1.8A7 7 0 1 0 4 17.5"/></svg></span>
      <span class="body"><span class="title">Weather &amp; Hazards</span><span class="sub">Live NWS alerts for your location</span></span>
      <span class="chev"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg></span>
    </button>

    <div class="section-label">Preparedness</div>
    <button class="card card--green" onclick="show('screen-myinfo')">
      <span class="icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="5" width="20" height="14" rx="2"/><line x1="6" y1="15" x2="10" y2="15"/><line x1="14" y1="15" x2="18" y2="15"/><circle cx="8" cy="10" r="1.6"/></svg></span>
      <span class="body"><span class="title">My Emergency Info</span><span class="sub">Medical card you can show a responder — saved on this device</span></span>
      <span class="chev"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg></span>
    </button>
    <button class="card card--gray" onclick="show('screen-reference')">
      <span class="icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2